# Google Cloud Configuration
# Place your Google Cloud service account JSON file path here for Google Cloud Speech-to-Text (si-LK)
GOOGLE_APPLICATION_CREDENTIALS=credentials/gcp-service-account.json

# Gemini API Key (used for contextual Sinhala grammar, punctuation, and fallback transcription)
GEMINI_API_KEY=your_gemini_api_key_here

# Service Settings
PORT=8080
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://www.canva.com,https://canva.com
MAX_AUDIO_SIZE_MB=100
DEFAULT_CHUNK_WORDS=5
